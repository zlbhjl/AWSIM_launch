digraph AWSIMTree {
  graph [fontname="Noto Sans CJK JP", nodesep=0.4, ranksep=0.6, bgcolor="#fcfcfb"];
  node [fontname="Noto Sans CJK JP", fontsize=13, style=filled, color="#52514e"];
  edge [fontname="Noto Sans CJK JP", fontsize=11, color="#52514e", fontcolor="#2a78d6"];

  purpose [label="目的", shape=diamond, fillcolor="#eb6834", fontcolor=white, width=1.2, height=0.9];
  explore_note [label="既存の探索(危険領域のサーチ)モード\n(explore/margin/jama_edge/\nttc_edge/worst_ttc/boundary_gap)\n※統計手法選択の対象外", shape=box, style="filled,dashed", fillcolor="#ececec"];

  goal [label="何を知りたいか", shape=box, fillcolor="#cde2fb"];
  proptype [label="指標の型", shape=box, fillcolor="#cde2fb"];
  sound_bin [label="被覆の厳密さ", shape=box, fillcolor="#cde2fb"];
  errtype [label="誤差の指定方法", shape=box, fillcolor="#cde2fb"];
  setting [label="サンプリング方式", shape=box, fillcolor="#cde2fb"];
  peeking [label="逐次的な多重チェックへの\n頑健性が必要か", shape=box, fillcolor="#cde2fb"];

  sprt [label="逐次確率比検定\nSequential Probability Ratio Test\n[--mode sprt]", shape=ellipse, fillcolor="#cdeecd"];
  clopper [label="Clopper–Pearson区間\n[--binomial-method clopper-pearson]", shape=box, fillcolor="#cde2fb"];
  wilson [label="Wilsonスコア区間\n(既定値)\n[--binomial-method wilson]", shape=box, fillcolor="#cde2fb"];
  peeking_no [label="単発の信頼区間として使用\n(既定)", shape=ellipse, fillcolor="#cdeecd"];
  peeking_yes [label="Alpha-spending補正\n[+ --binomial-anytime-valid]\n(必要サンプル数が約5〜8倍に増加)", shape=ellipse, fillcolor="#cdeecd"];
  dkw_seq [label="Dvoretzky–Kiefer–Wolfowitz不等式(逐次)\n[--mode dkw]\n--dkw_region で領域指定可", shape=ellipse, fillcolor="#cdeecd"];
  dkw_fixed [label="Dvoretzky–Kiefer–Wolfowitz不等式(固定回数)\n[--mode dkw_fixed]", shape=ellipse, fillcolor="#cdeecd"];
  ebstop [label="経験的Bernstein停止則\nEmpirical Bernstein Stopping\n[--mode ebstop]", shape=ellipse, fillcolor="#cdeecd"];

  purpose -> explore_note [label="危険領域を探索したい"];
  purpose -> goal [label="指標を推定/証明したい"];

  goal -> sprt [label="ある閾値を超えるか/下回るかを\n判定したい (仮説検定)"];
  goal -> proptype [label="値がどの範囲にあるかを\n推定したい (区間推定)"];

  proptype -> sound_bin [label="二値 (例: c_collision)"];
  proptype -> errtype [label="連続値 (例: min_ttc,\nmin_distance)"];

  sound_bin -> clopper [label="厳密な被覆保証が必要 (yes)"];
  sound_bin -> wilson [label="近似で十分 (no)"];

  clopper -> peeking;
  wilson -> peeking;
  peeking -> peeking_no [label="不要"];
  peeking -> peeking_yes [label="必要"];

  errtype -> setting [label="絶対誤差"];
  errtype -> ebstop [label="相対誤差"];

  setting -> dkw_seq [label="逐次"];
  setting -> dkw_fixed [label="固定回数"];
}
