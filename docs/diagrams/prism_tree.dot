digraph PRISMTree {
  graph [fontname="Noto Sans CJK JP", nodesep=0.4, ranksep=0.6, bgcolor="#fcfcfb"];
  node [fontname="Noto Sans CJK JP", fontsize=13, style=filled, color="#52514e"];
  edge [fontname="Noto Sans CJK JP", fontsize=11, color="#52514e", fontcolor="#2a78d6"];

  no_explore [label="探索(危険領域のサーチ)は対象外\n(jama_edge等の探索モードはPRISM非対応。\nGP回帰による境界推定も実装しない方針で確定)", shape=box, style="filled,dashed", fillcolor="#ececec"];
  goal [label="何を知りたいか", shape=diamond, fillcolor="#eb6834", fontcolor=white, width=1.2, height=0.9];
  proptype [label="指標の型", shape=box, fillcolor="#cde2fb"];
  sound_bin [label="被覆の厳密さ", shape=box, fillcolor="#cde2fb"];
  errtype [label="誤差の指定方法", shape=box, fillcolor="#cde2fb"];
  peeking [label="逐次的な多重チェックへの\n頑健性が必要か", shape=box, fillcolor="#cde2fb"];

  sprt [label="逐次確率比検定\nSequential Probability Ratio Test\n[--mode sprt --target prism]", shape=ellipse, fillcolor="#cdeecd"];
  clopper [label="Clopper–Pearson区間\n[--binomial-method clopper-pearson]", shape=box, fillcolor="#cde2fb"];
  wilson [label="Wilsonスコア区間\n(既定値)\n[--binomial-method wilson]", shape=box, fillcolor="#cde2fb"];
  peeking_no [label="単発の信頼区間として使用\n(既定)", shape=ellipse, fillcolor="#cdeecd"];
  peeking_yes [label="Alpha-spending補正\n[+ --binomial-anytime-valid --target prism]\n(必要サンプル数が約5〜8倍に増加)", shape=ellipse, fillcolor="#cdeecd"];
  dkw_gap [label="Dvoretzky–Kiefer–Wolfowitz不等式\n[--mode dkw/dkw_fixed --target prism]", shape=ellipse, fillcolor="#cdeecd"];
  ebstop [label="経験的Bernstein停止則\nEmpirical Bernstein Stopping\n[--mode ebstop --target prism]", shape=ellipse, fillcolor="#cdeecd"];

  no_explore -> goal [style=invis];
  goal -> sprt [label="ある閾値を超えるか/下回るかを\n判定したい (仮説検定)"];
  goal -> proptype [label="値がどの範囲にあるかを\n推定したい (区間推定)"];

  proptype -> sound_bin [label="二値 (例: c_failure,\nmaude_violation)"];
  proptype -> errtype [label="連続値/カウント (例:\nsteps_to_failure_capped,\ndegraded_visit_count)"];

  sound_bin -> clopper [label="厳密な被覆保証が必要 (yes)"];
  sound_bin -> wilson [label="近似で十分 (no)"];

  clopper -> peeking;
  wilson -> peeking;
  peeking -> peeking_no [label="不要"];
  peeking -> peeking_yes [label="必要"];

  errtype -> dkw_gap [label="絶対誤差"];
  errtype -> ebstop [label="相対誤差"];

  { rank=same; no_explore; goal; }
}
