digraph PRISMTree {
  graph [fontname="Noto Sans CJK JP", nodesep=0.35, ranksep=0.55, bgcolor="#fcfcfb"];
  node [fontname="Noto Sans CJK JP", fontsize=13, style=filled, color="#52514e"];
  edge [fontname="Noto Sans CJK JP", fontsize=11, color="#52514e", fontcolor="#2a78d6"];

  no_explore [label="探索系モードは存在しない\n(jama_edge等はPRISM非対応。\nGP境界推定も実装しない方針で確定)", shape=box, style="filled,dashed", fillcolor="#ececec"];
  goal [label="知りたいこと", shape=diamond, fillcolor="#eb6834", fontcolor=white, width=1.2, height=0.9];
  proptype [label="指標の型", shape=box, fillcolor="#cde2fb"];
  sound_bin [label="健全性が\n必要か", shape=box, fillcolor="#cde2fb"];
  errtype [label="誤差の\n指定", shape=box, fillcolor="#cde2fb"];

  sprt [label="SPRT\n--mode sprt --target prism", shape=ellipse, fillcolor="#cdeecd"];
  clopper [label="Clopper-Pearson\n--binomial-method\nclopper-pearson", shape=box, fillcolor="#cde2fb"];
  wilson [label="Wilson\n--binomial-method wilson\n(デフォルト、標準/不健全)", shape=box, fillcolor="#cde2fb"];
  peeking [label="何度もチェックする間\n理論的妥当性を保ちたいか\n(repeated peeking)", shape=box, fillcolor="#cde2fb"];
  peeking_no [label="そのまま\n(既定。--binomial-anytime-validなし)", shape=ellipse, fillcolor="#cdeecd"];
  peeking_yes [label="+ --binomial-anytime-valid\n--target prism\n(必要サンプル数が約5〜8倍に増加)", shape=ellipse, fillcolor="#cdeecd"];
  dkw_gap [label="DKW\n--mode dkw/dkw_fixed --target prism", shape=ellipse, fillcolor="#cdeecd"];
  ebstop [label="EBStop\n--mode ebstop --target prism", shape=ellipse, fillcolor="#cdeecd"];

  no_explore -> goal [style=invis];
  goal -> sprt [label="閾値を超えるか判定したい\n(仮説検定)"];
  goal -> proptype [label="値の範囲を推定したい\n(区間推定)"];

  proptype -> sound_bin [label="二値 (例: c_failure,\nmaude_violation)"];
  proptype -> errtype [label="連続値/カウント (例:\nsteps_to_failure_capped,\ndegraded_visit_count)"];

  sound_bin -> clopper [label="yes"];
  sound_bin -> wilson [label="no"];

  clopper -> peeking;
  wilson -> peeking;
  peeking -> peeking_no [label="不要"];
  peeking -> peeking_yes [label="必要"];

  errtype -> dkw_gap [label="絶対誤差"];
  errtype -> ebstop [label="相対誤差"];

  { rank=same; no_explore; goal; }
}
